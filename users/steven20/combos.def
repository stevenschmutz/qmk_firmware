
//COMB(key_DEL,  KC_DEL, TD(TD_EL_ES),ALT_DOWN)
COMB(key_Backspace,  KC_BSPC, TD(TD_CEE_TEE) , TD(TD_ARR_EN))


COMB(key_i,      KC_I,  TD(TD_PEE_U_LAYER_NUM),    TD(TD_DOT_EE_LAYER_PARA))
COMB(key_d,      KC_D,  TD(TD_GEE_AITCH),    TD(TD_CEE_TEE))
COMB(key_x,      KC_X,  CKC_J,    LT(_ART_PARA,KC_K))
COMB(key_b,      KC_B,  CKC_M,    KC_W)

COMB(key_y,      KC_Y, TD(TD_COMMA_OH_CUT), TD(TD_DOT_EE_LAYER_PARA) , TD(TD_PEE_U_LAYER_NUM) )
COMB(key_QUOTE_BOLD  , QUOTE_BOLD, TD(TD_QUOTE_A_BOLD),CKC_SCLN)
COMB(key_COMMA_CUT  , COMMA_CUT,TD(TD_COMMA_OH_CUT),CKC_Q )
COMB(key_DOT_COPY  ,  DOT_COPY, TD(TD_DOT_EE_LAYER_PARA),CKC_J)
COMB(key_PEE_PASTE  , PEE_PASTE, TD(TD_PEE_U_LAYER_NUM),LT(_ART_PARA,KC_K) )
COMB(key_GreaterThan,  KC_GT, TD(TD_COMMA_OH_CUT)  ,  TD(TD_DOT_EE_LAYER_PARA))
COMB(key_LessThan,  KC_LT, TD(TD_QUOTE_A_BOLD), TD(TD_COMMA_OH_CUT))




COMB(key_f,      KC_F,  TD(TD_GEE_AITCH) , TD(TD_CEE_TEE) , TD(TD_ARR_EN) )
COMB(key_KC_G,   KC_G,  TD(TD_GEE_AITCH),CKC_M)
COMB(key_KC_C,   KC_C,  TD(TD_CEE_TEE),KC_W)
COMB(key_KC_R,   KC_R,  TD(TD_ARR_EN),KC_V)
COMB(key_KC_L,  KC_L, TD(TD_EL_ES),ALT_DOWN)


COMB(wvCTRSAVE,      CTRL_SAVE, KC_W,    KC_V)
COMB(vzUNDO,      CTRL_UNDO, CKC_M,    KC_V)
//ESC
COMB(uhESC,  KC_ESC,   TD(TD_PEE_U_LAYER_NUM), TD(TD_GEE_AITCH))


//COMB(key_UP,  KC_UP, KC_S,ALT_DOWN)
//COMB(key_DOWN,  KC_DOWN, KC_S,ALT_DOWN)
COMB(key_LEFT,  KC_LEFT, CKC_Q, CKC_J, LT(_ART_PARA,KC_K))
COMB(key_RIGHT,  KC_RIGHT, CKC_M, KC_W, KC_V,ALT_DOWN)
COMB(key_HOME,  KC_HOME, CKC_SCLN, CKC_Q, CKC_J, LT(_ART_PARA,KC_K))
COMB(key_END,  KC_END, CKC_M, KC_W, KC_V)  


