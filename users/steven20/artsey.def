
//WORD COMBOS
SUBS(artsey_the,"the",LEFT_1_1,LEFT_1_2,LEFT_1_3)
SUBS(artsey_and,"and",LEFT_2_1,LEFT_2_2,LEFT_2_3)
SUBS(artsey_from,"from",LEFT_1_2,LEFT_1_3,LEFT_1_4)
SUBS(artsey_you,"you",LEFT_2_2,LEFT_2_3,LEFT_2_4)


///ORIGINAL ARTSEY
COMB(artsey_h,KC_H,BASE_2_1,BASE_2_3)
COMB(artsey_q,KC_Q,BASE_1_1,BASE_1_3,BASE_1_4)
COMB(artsey_u,KC_U,BASE_2_2,BASE_2_3)
COMB(artsey_c,KC_C,BASE_2_1,BASE_2_2)
COMB(artsey_k,KC_K,BASE_2_2,BASE_2_4)
COMB(artsey_b,KC_B,BASE_2_1,BASE_2_4)
COMB(artsey_w,KC_W,BASE_1_1,BASE_1_4)
COMB(artsey_n,KC_Y,BASE_2_3,BASE_2_4)
COMB(artsey_f,KC_F,BASE_1_1,BASE_1_2)
COMB(artsey_x,KC_X,BASE_1_2,BASE_1_3,BASE_1_4)
COMB(artsey_j,KC_J,BASE_1_3,BASE_1_4)
COMB(artsey_m,KC_M,BASE_2_2,BASE_2_3,BASE_2_4)
COMB(artsey_p,KC_P,BASE_2_1,BASE_2_3,BASE_2_4)
COMB(artsey_v,KC_V,BASE_1_2,BASE_1_4)
COMB(artsey_l,KC_L,BASE_2_1,BASE_2_2,BASE_2_3)
COMB(artsey_z,KC_Z,BASE_1_1,BASE_1_2,BASE_1_3,BASE_1_4)
COMB(artsey_d,KC_D,BASE_1_1,BASE_1_2,BASE_1_3)
COMB(artsey_g,KC_G,BASE_1_2,BASE_1_3)

COMB(artsey_space,KC_SPC,BASE_2_1,BASE_2_2,BASE_2_3,BASE_2_4)
COMB(artsey_backspace,KC_BSPC,BASE_2_1,BASE_1_2)
COMB(artsey_del,KC_DEL,BASE_1_2,BASE_2_3)

COMB(artsey_enter,KC_ENTER,BASE_1_1,BASE_2_1)
COMB(artsey_escape,KC_ESC,BASE_1_1,BASE_1_2,BASE_2_4)
COMB(artsey_quote,KC_QUOT,BASE_1_2,BASE_2_2)
COMB(artsey_bang,KC_EXLM,BASE_1_3,BASE_2_3)
COMB(artsey_quest,KC_QUES,BASE_1_4,BASE_2_4)

//SYMBOL COMBOS
COMB(artsey_percentage,KC_PERC,SYM_1_1,SYM_1_2)
COMB(artsey_dollar,KC_DLR,SYM_2_1,SYM_2_2)
COMB(vzKappie,  KC_CIRC, SYM_1_3,SYM_1_2)
COMB(artsey_tilde,KC_TILDE,SYM_2_3,SYM_2_2)
COMB(artsey_gbp,  UC(0x00A3), SYM_1_3,SYM_1_4)


//LEFT COMBOS
COMB(artsey_printscreen,KC_PSCR,LEFT_1_1, LEFT_1_2)


//PUNCTUATION COMBOS
COMB(artsey_underscore,KC_UNDS,PUNC_1_1,PUNC_1_2)
COMB(artsey_pipe,KC_PIPE,PUNC_1_2,PUNC_1_3)
COMB(artsey_backslash,KC_BSLS,PUNC_2_1,PUNC_2_2)
COMB(artsey_forwardslash,KC_SLASH,PUNC_2_2,PUNC_2_3)

//NUMBER COMBOS
COMB(artsey_7,KC_7,NUM_1_1,NUM_1_2)
COMB(artsey_8,KC_8,NUM_1_2,NUM_1_3)
COMB(artsey_9,KC_9,NUM_2_1,NUM_2_2)
COMB(artsey_0,KC_0,NUM_2_2,NUM_2_3)

COMB(artsey_nav,TG(_ART_NAV),BASE_1_2,BASE_2_1,BASE_2_3)
COMB(artsey_main1,TG(_ART_BASE),NAV_1_2,NAV_2_1,NAV_2_3)
//COMB(artsey_mou,TG(_ART_MOU),BASE_1_1,BASE_1_3,BASE_2_2)
//COMB(artsey_main2,TG(_ART_BASE),MOU_1_1,MOU_1_3,MOU_2_2)

COMB(artsey_comma,KC_COMM,BASE_1_1,BASE_2_3)
COMB(artsey_period,KC_DOT,BASE_1_1,BASE_2_2)
COMB(artsey_slash,KC_SLSH,BASE_1_1,BASE_2_4)
COMB(artsey_tab,KC_TAB,BASE_1_1,BASE_1_2,BASE_1_3,BASE_2_4)
COMB(artsey_os_shift,OSM(MOD_LSFT),BASE_2_1,BASE_1_2,BASE_1_3,BASE_1_4)
COMB(artsey_colon,KC_COLON,BASE_2_1,BASE_2_2)


COMB(artsey_ctrl,KC_LCTL,BASE_1_4,BASE_2_1)
//COMB(artsey_ctrl_2,KC_LCTL,NAV_1_4,NAV_2_1)
//COMB(artsey_ctrl_3,KC_LCTL,MOU_1_4,MOU_2_1)

COMB(artsey_gui,KC_LGUI,BASE_1_4,BASE_2_2)
