//	COMB(artsey_gui_3,KC_LGUI,MOU_1_4,MOU_2_2)

COMB(artsey_alt,KC_LALT,BASE_1_4,BASE_2_3)
//COMB(artsey_alt_2,KC_LALT,NAV_1_4,NAV_2_3)
//COMB(artsey_alt_3,KC_LALT,MOU_1_4,MOU_2_3)


COMB(artsey_shift,KC_LSFT ,BASE_1_1,BASE_2_2,BASE_2_3,BASE_2_4)
COMB(artsey_shift_2,KC_LSFT ,NAV_1_1,NAV_2_2,NAV_2_3,NAV_2_4)
